# ========================================
# Instructions
# ========================================
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env file to version control
# 4. Keep this file secure and private

# ========================================
# Server Configuration
# ========================================
NODE_ENV=development
PORT=5000
IP_ADDRESS=localhost
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ========================================
# Database Configuration
# ========================================
DATABASE_URL=mongodb://localhost:27017/your-database-name

# ========================================
# Redis (Socket.io cross-worker delivery — required in production cluster mode)
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# Security & Encryption
# ========================================
BCRYPT_SALT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========================================
# JWT Configuration
# ========================================
# Generate secure keys: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRE_IN=30d
RESET_TOKEN_EXPIRE_TIME=10

# ========================================
# Socket.IO Configuration
# ========================================
SOCKET_PORT=5001

# ========================================
# Twilio (SMS / Phone OTP)
# ========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ========================================
# Super Admin Seed (used by `npm run seed`)
# ========================================
SUPER_ADMIN_PHONE=+971500000000
SUPER_ADMIN_EMAIL=admin@rora.app
SUPER_ADMIN_PASSWORD=change-this-before-seeding

# ========================================
# Stripe (Payment Gateway — customer recharge only)
# ========================================
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_URL=http://localhost:5000/api/v1/webhook/stripe
STRIPE_PRODUCT_ID=

# ========================================
# AWS S3 Configuration (File Uploads)
# ========================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-bucket-name

# ========================================
# Firebase (Push Notifications — FCM only, not storage)
# ========================================
# From your Firebase service account JSON (Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----\n"
